<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>KeePassGate</AssemblyName>
    <RootNamespace>KeePassGate</RootNamespace>
    <!-- KeePass finds the entry point by name: the file KeePassGate.dll must contain a type
         called KeePassGateExt deriving from KeePass.Plugins.Plugin. Renaming the assembly
         renames the type it must expose. -->
    <!-- Load bearing, and silently so. KeePass reads the file's ProductName before it opens the
         assembly and skips anything that does not say exactly this, with no message and no entry
         in its plugin list. See FINDINGS.md. -->
    <Product>KeePass Plugin</Product>
    <AssemblyTitle>KeePassGate</AssemblyTitle>
    <Description>Serves a small specification defined HTTP API over mutual TLS, so automation can be given a narrow, revocable, audited slice of a KeePass database.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: KeePass.exe is the host process and must never be copied beside the plugin. -->
    <Reference Include="KeePass">
      <HintPath>$(KeePassExePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The TLS server. Taken so that the host key never has to be written to the user's profile,
         which is what SChannel requires and what the design forbids. MIT, and it ships beside the
         plugin: KeePass loads plugins with Assembly.LoadFrom, which probes their own directory. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- The routing table is an OpenAPI document, so something has to read one. Measured before it
         was taken: three assemblies including its YAML reader, and it works on .NET Framework 4.8,
         which was the doubt. `FINDINGS.md`, under "The document as the routing table", records
         the number and how it was taken: cited by its title because the numbering shifts as
         sections are added above it. No schema library is taken for the body checking beside it,
         and the counts that decided that are on the `spikes/json-reading` branch. MIT. -->
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.31" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.31" />
    <!-- Reading and writing JSON: one assembly, MIT, and nothing arrives with it.
         `System.Text.Json` was measured at nine on this framework, one of them
         `System.Runtime.CompilerServices.Unsafe`, which wants a binding redirect a plugin cannot
         supply because the only configuration file in play is KeePass's own. The counts are on the
         `spikes/json-reading` branch. What stays written here is the policy over what it parses, which
         is a decision rather than a grammar. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- The routing document is embedded rather than shipped beside the plugin, so the routing table
       cannot be edited apart from the assembly that serves it. What is embedded is the file with
       `Version` written into its `info.version`, which the file holds a placeholder for, since YAML
       cannot read a version from anywhere: so a version is moved in `Directory.Build.props` alone,
       and a patch to the client alone changes nothing under this directory. A file without the
       placeholder, or with it twice, fails the build. Written beside the rest of the build's own
       files, and only when it differs, so a build that changes nothing compiles nothing. -->
  <UsingTask TaskName="StampRoutingDocument" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string Placeholder = "version: 0.0.0-placeholder";
        // Strict, and without a mark: the bytes go back out exactly as they came in, but for the
        // version, and a file that is not UTF-8 stops the build rather than being rewritten.
        var encoding = new UTF8Encoding(false, true);
        var text = encoding.GetString(File.ReadAllBytes(Source));
        var at = text.IndexOf(Placeholder, StringComparison.Ordinal);
        if (at < 0 || text.IndexOf(Placeholder, at + 1, StringComparison.Ordinal) >= 0)
        {
            Log.LogError(Source + " has to hold \"" + Placeholder + "\" exactly once, where the build writes the version.");
            return false;
        }

        var stamped = text.Replace(Placeholder, "version: " + Version);
        if (!File.Exists(Destination) || File.ReadAllText(Destination, encoding) != stamped)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Destination));
            File.WriteAllBytes(Destination, encoding.GetBytes(stamped));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StampRoutingDocument" AfterTargets="PrepareForBuild">
    <PropertyGroup>
      <StampedRoutingDocument>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'openapi.yaml'))</StampedRoutingDocument>
    </PropertyGroup>
    <StampRoutingDocument Source="$(MSBuildProjectDirectory)\Spec\openapi.yaml"
                          Destination="$(StampedRoutingDocument)" Version="$(Version)" />
    <ItemGroup>
      <EmbeddedResource Include="$(StampedRoutingDocument)" LogicalName="KeePassGate.Spec.openapi.yaml" />
      <FileWrites Include="$(StampedRoutingDocument)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="KeePassGate.Tests" />
    <InternalsVisibleTo Include="KeePassGate.Host.Tests" />
  </ItemGroup>

  <Target Name="RequireKeePassDevDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(KeePassExePath)')"
           Text="KeePass.exe was not found at $(KeePassExePath). Run `.\build.ps1 -Task KeePass` to provide the version this repository pins, or build with -p:KeePassDevDir=&lt;path&gt;." />
  </Target>

</Project>
