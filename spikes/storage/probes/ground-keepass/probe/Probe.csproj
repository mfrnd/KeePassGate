<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console probe against KeePass 2.62's KeePassLib, read out of the KeePass.exe this branch
       provides as $(KeePassExe). No window: only KeePassLib types are used. Throwaway databases only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
    </Reference>
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
