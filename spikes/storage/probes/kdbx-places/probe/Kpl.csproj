<Project Sdk="Microsoft.NET.Sdk">

  <!-- KeePassLib 2.62, read out of the KeePass.exe this branch provides as $(KeePassExe): makes the
       databases of `kdbx-places` and runs KeePass's own operations on them. No window: only
       KeePassLib types are used, and System.Drawing only to make the icons' PNG bytes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
    </Reference>
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
