<Project Sdk="Microsoft.NET.Sdk">

  <!-- Added to run the probe from the branch. Its agent compiled `Mine.cs` with the .NET SDK's
       Roslyn `csc` (`-langversion:7.3 -platform:x64`, no `-optimize`, no `-debug`), with nothing in
       a project file, into a 64-bit `Probe.exe`, against the .NET Framework 4.8 reference
       assemblies of `Microsoft.NETFramework.ReferenceAssemblies` 1.0.3, a copy of the pinned
       KeePass.exe, the product's `Newtonsoft.Json.dll` and copies of eight of the product's files.
       This builds the same source with the same eight files, exported from the product's commit by
       `tools\Product.ps1`, as the same 64-bit executable under the same name, with the JIT's
       optimizations left off as the agent's build had them, against the KeePass
       `spikes\storage\Directory.Build.props` provides and Newtonsoft.Json 13.0.4, the version the
       product pins and the DLL the agent linked. No window: only KeePassLib types are used, and
       `keepassxc-cli` is started as a console child. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Probe</AssemblyName>
    <Optimize>false</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);1591;0168;0219;0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ProductDir)src\KeePassGate\Acl\AclDocument.cs" />
    <Compile Include="$(ProductDir)src\KeePassGate\Acl\AclDocuments.cs" />
    <Compile Include="$(ProductDir)src\KeePassGate\Acl\AclGrant.cs" />
    <Compile Include="$(ProductDir)src\KeePassGate\Acl\AclInheritance.cs" />
    <Compile Include="$(ProductDir)src\KeePassGate\Acl\AclResolver.cs" />
    <Compile Include="$(ProductDir)src\KeePassGate\Acl\AclVerb.cs" />
    <Compile Include="$(ProductDir)src\KeePassGate\Acl\VerbMask.cs" />
    <Compile Include="$(ProductDir)src\KeePassGate\Transport\JsonBody.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
