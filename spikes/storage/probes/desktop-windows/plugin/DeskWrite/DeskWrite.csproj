<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measurement 3's writing plugin: a plain DLL for the throwaway KeePass copy, never part of the
       product. It writes to a live entry while that entry's dialog is open, as a plugin writing a
       reference onto a user's entry would, and reports what the entry holds in memory. KeePass
       loads it only with ProductName exactly "KeePass Plugin" and the entry class
       DeskWrite.DeskWriteExt in DeskWrite.dll. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DeskWrite</AssemblyName>
    <RootNamespace>DeskWrite</RootNamespace>
    <Product>KeePass Plugin</Product>
    <AssemblyTitle>DeskWrite</AssemblyTitle>
    <Company>invented</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
