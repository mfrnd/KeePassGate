<Project Sdk="Microsoft.NET.Sdk">

  <!-- A managed host for the family's PowerShell scripts. Windows PowerShell 5.1's powershell.exe
       is a native host, and in it UI automation's client-side providers fail to load
       (ProxyManager.LoadDefaultProxies throws NullReferenceException), which leaves KeePass's
       entry list and group tree bare panes. Run inside this executable, the same scripts get the
       providers the framework loads for any managed program. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DeskHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management.Automation">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\System.Management.Automation\v4.0_3.0.0.0__31bf3856ad364e35\System.Management.Automation.dll</HintPath>
    </Reference>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
