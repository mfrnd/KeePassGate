# Step 7, Keepass2Android's conflict path, as the spike's k2a-B.flow: open the target, push the
# arriving copy ${ARRIVING} over the file underneath it, add an entry at the root, and answer the
# "Merge changes?" question that the save raises with "Yes, merge".
include k2a-open.flow
adb push ${SRCDIR}/${ARRIVING}.kdbx /sdcard/Download/${NAME}.kdbx
sh sha256sum /sdcard/Download/${NAME}.kdbx
sleep 3
tap fabAddNew
tap fabAddNewEntry
maybe ^No$ 4                      # "Add templates?" on the first entry added
waitfor entry_title 20
tap entry_title
text ${ENTRY}
tap menu_save
waitfor Merge.changes 60
list
tap ^Yes,.merge$
waitfor fabAddNew 60
sleep 5
list
