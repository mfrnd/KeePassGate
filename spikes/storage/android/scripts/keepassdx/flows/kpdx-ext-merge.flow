# Item 2, the external-change path, answer Merge data: open the target, put the source over the
# file with the device's clock as its time (more than 10 s past the opened file's), leave for the
# home screen and come back; the dialog; OK; Merge data from the overflow menu (it merges and saves).
include kpdx-open.flow
sleep 11
sh stat -c '%s bytes, mtime %y' /sdcard/Download/${NAME}.kdbx
adb push ${SRC} /sdcard/Download/${NAME}.kdbx
sh touch /sdcard/Download/${NAME}.kdbx
sh stat -c '%s bytes, mtime %y' /sdcard/Download/${NAME}.kdbx
sh sha256sum /sdcard/Download/${NAME}.kdbx
mark /sdcard/Download/${NAME}.kdbx
key HOME
sleep 2
sh monkey -p ${PKG} -c android.intent.category.LAUNCHER 1
waitfor modified.outside 40
dialog
list
tap ^OK$
sleep 3
tapuntil More.options ^Merge.data$ 30
tap ^Merge.data$
waitchange /sdcard/Download/${NAME}.kdbx 90
sleep 10
dialog
sh stat -c '%s bytes, mtime %y' /sdcard/Download/${NAME}.kdbx
list
