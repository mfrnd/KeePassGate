# Item 1, state a: open; with ALWAYSMERGE=on the File handling screen shown and "Always merge on
# conflict" pressed (k2a-setting.flow); SNEW-fixed put on the server; the save with the server
# frozen; state a; nobody there; back to it; a second save.
include k2a-sy-open.flow
include k2a-bg-amc-${ALWAYSMERGE}.flow
host sh ${P}/prefs.sh before-run
host sh ${P}/srv-put.sh ${SNAME} ${SRCDIR}/SNEW-fixed.kdbx
include k2a-bg-save-frozen.flow
include k2a-bg-a.flow
include k2a-bg-unattended.flow
include k2a-bg-return-a.flow
include k2a-bg-after.flow
