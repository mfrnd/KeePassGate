# Overwrite, KeePassDroid, replacement with the program on screen: open OLD through its Open button
# (the system file picker) and unlock; replace.sh puts ${ARRIVING} over the file at time ${TMODE};
# then add an entry ${ENTRY} at the root and save, recording any dialog.
include kpd-open.flow
sleep 2
host sh ${P}/replace.sh /sdcard/Download/${NAME}.kdbx ${SRCDIR}/${ARRIVING}.kdbx ${TMODE}
sleep 3
dialog
include kpd-ow-edit.flow
