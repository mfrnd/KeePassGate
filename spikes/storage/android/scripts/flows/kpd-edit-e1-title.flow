# Step 2, KeePassDroid: open, go into G, open E1, EDIT (bottom left, the dump gives it no bounds;
# the screen is FLAG_SECURE), append -phone to its name (checked: the password fields show nothing
# the flow can check), SAVE.
include kpd-open.flow
tap ^G$
tap ^E1$
waitfor entry_edit 30
tapxy 140 2141
waitfor entry_confpassword 30
list
append entry_title@.* -phone
tapor entry_save 140 2141
waitfor entry_edit 60
sleep 6
list
