<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console probe against KeePass 2.62's KeePassLib, read out of the KeePass.exe the branch
       provides, modeled on the spike's Probe.csproj. No window: only KeePassLib types are
       used. Throwaway databases with invented content only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>StoreProbe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
    </Reference>
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Added on the branch: the later state of this probe is a project of its own in `overwrite\`,
       and none of its sources or build output belong to this project. -->
  <ItemGroup>
    <Compile Remove="overwrite\**" />
  </ItemGroup>

</Project>
