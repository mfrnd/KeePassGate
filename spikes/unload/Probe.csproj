<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console probe that drives a running KeePass through UI automation from inside a child
       application domain and then unloads that domain, the way the NUnit engine unloads the domain a
       test run lived in. It compiles against nothing of KeePass's: the KeePass it talks to is a
       separate process, started by `run.ps1` from the version `keepass.version` pins. The client
       side of UI automation is WPF's, so the two reference assemblies come from the framework. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
