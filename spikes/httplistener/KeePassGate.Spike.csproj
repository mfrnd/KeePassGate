<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proof that the vendored managed HttpListener can be ported to .NET Framework and driven from
    an SslStream this project authenticates itself. net48 because SslProtocols.Tls13 exists only
    there; the reference assemblies come from the NuGet package because the 4.8 targeting pack is
    not installed on every machine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>KeePassGate.Spike</AssemblyName>
    <RootNamespace>KeePassGate.Spike</RootNamespace>
    <!-- The vendored sources are not ours to tidy, and their warnings are not signal here. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0618;SYSLIB0014;CA5359</NoWarn>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- HttpListenerContext is declared `unsafe partial` upstream. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- ReadOnlySpan<T>, used by the vendored chunk reader and request parser. -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

</Project>
