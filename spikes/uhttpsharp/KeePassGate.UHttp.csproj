<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measuring what vendoring uHttpSharp costs, against the same harness as the other port. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KeePassGate.UHttp</AssemblyName>
    <RootNamespace>KeePassGate.UHttp</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS0067;CS0169;CS0649;SYSLIB0014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Spec-first: parse the OpenAPI document, validate bodies against its schemas. -->
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.22" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <Reference Include="System.Web" />
    <!-- LibLog uses dynamic. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
