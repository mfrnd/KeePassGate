<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measuring what vendoring websocket-sharp's HTTP layer costs, same harness as the others. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KeePassGate.WsSharp</AssemblyName>
    <RootNamespace>KeePassGate.WsSharp</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS0067;CS0169;CS0649;SYSLIB0014;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
