# Anchored with a leading slash, so that a rule meant for one place cannot quietly match another
# somewhere else. What a project writes is ignored beside that project rather than from here.

/.tmp/
/node_modules/
/scratchpad/

# Per machine, and not everybody's business: the checked-in `.claude/settings.json` is.
/.claude/settings.local.json

# What `tools/KeePass.ps1` fetches, named after the version so that changing the pin cannot quietly
# reuse the last one. Provided rather than committed: it is somebody else's program.
/.keepass/

# The probe's build output, and the throwaway copy of KeePass the runner starts and the logs of
# the per fixture runner when told to work here.
/spikes/unload/bin/
/spikes/unload/obj/
/spikes/unload/out/
/work/
