<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>KeePassGate.Host.Tests</AssemblyName>
    <RootNamespace>KeePassGate.Host.Tests</RootNamespace>
    <!-- These tests need a real KeePass. They assert that the names the plugin reaches for still
         exist, and they drive the real dialogs and the real window notifications, which is the
         only way to find out that a KeePass upgrade has moved something. -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied into the test output, unlike in the plugin, because here KeePass is the thing
         under test rather than the host process. -->
    <Reference Include="KeePass">
      <HintPath>$(KeePassExePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KeePassGate\KeePassGate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same client and answer reader the loopback tests use, so the end to end test cannot
         pass against a protocol only it knows. -->
    <Compile Include="..\Shared\HttpAnswer.cs" Link="Shared\HttpAnswer.cs" />
    <Compile Include="..\Shared\PairingClient.cs" Link="Shared\PairingClient.cs" />
    <Compile Include="..\Shared\PrivateKeyFiles.cs" Link="Shared\PrivateKeyFiles.cs" />
    <Compile Include="..\Shared\CertificateUris.cs" Link="Shared\CertificateUris.cs" />
    <Compile Include="..\Shared\Rules.cs" Link="Shared\Rules.cs" />
    <Compile Include="..\Shared\Bodies.cs" Link="Shared\Bodies.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The live test needs the whole KeePass directory, not just the assembly it compiles
         against, so the path is baked in rather than guessed at run time. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KeePassDevDir</_Parameter1>
      <_Parameter2>$(KeePassDevDir)</_Parameter2>
    </AssemblyAttribute>
    <!-- And the release `keepass.version` names, which the contract tests hold the referenced
         KeePass to: a directory given on the command line can hold any release. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KeePassPinnedVersion</_Parameter1>
      <_Parameter2>$(KeePassPinnedVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="RequireKeePassDevDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(KeePassExePath)')"
           Text="KeePass.exe was not found at $(KeePassExePath). Run `.\build.ps1 -Task KeePass` to provide the version this repository pins, or build with -p:KeePassDevDir=&lt;path&gt;." />
  </Target>

</Project>
