<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>KeePassGate.Tests</AssemblyName>
    <RootNamespace>KeePassGate.Tests</RootNamespace>
    <!-- These tests never load KeePass. Everything they exercise is written against the seams
         rather than against the host, and a failure to keep that true shows up here as a missing
         assembly rather than as a design argument. -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KeePassGate\KeePassGate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client half of pairing and the reader it takes an answer with, compiled into both
         test assemblies. One copy, because the loopback tests and the end to end tests have to be
         talking to the same protocol for either of them to mean anything. -->
    <Compile Include="..\Shared\HttpAnswer.cs" Link="Shared\HttpAnswer.cs" />
    <Compile Include="..\Shared\PairingClient.cs" Link="Shared\PairingClient.cs" />
    <Compile Include="..\Shared\PrivateKeyFiles.cs" Link="Shared\PrivateKeyFiles.cs" />
  </ItemGroup>

</Project>
