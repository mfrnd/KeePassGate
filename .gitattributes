# Normalize to LF in the repository and check out what the platform expects, so that a machine
# without core.autocrlf still produces the same diffs.
* text=auto

# Windows tooling that is happier with CRLF regardless of the checkout.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sln text eol=crlf

*.cs text diff=csharp
*.csproj text
*.props text
*.md text

# Never normalize a database or a certificate.
*.kdbx binary
*.pfx binary
*.cer binary
*.png binary
*.sh text eol=lf
