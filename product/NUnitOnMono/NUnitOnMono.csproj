<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs an NUnit test assembly in this process through NUnit's own framework API, with no
    adapter and no test host, so it runs wherever the assembly does: on Mono as well as on .NET
    Framework. Compiled against the plugin's NUnit and never shipped with a copy of it: the script
    puts this executable beside the test assembly, which brings its own.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>NUnitOnMono</RootNamespace>
    <AssemblyName>NUnitOnMono</AssemblyName>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="4.6.1" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
